{
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5300" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "clients": {
        "ClusterId": "clients",
        "Match": { "Path": "/api/clients/{**catch-all}" }
      },
      "classes": {
        "ClusterId": "classes",
        "Match": { "Path": "/api/classes/{**catch-all}" }
      },
      "sessions": {
        "ClusterId": "classes",
        "Match": { "Path": "/api/sessions/{**catch-all}" }
      },
      "bookings": {
        "ClusterId": "bookings",
        "Match": { "Path": "/api/bookings/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Metadata": { "DisplayName": "Identity" },
        "Destinations": { "identity": { "Address": "http://localhost:5170/" } }
      },
      "clients": {
        "Metadata": { "DisplayName": "Clientes" },
        "Destinations": { "clients": { "Address": "http://localhost:5180/" } }
      },
      "classes": {
        "Metadata": { "DisplayName": "Clases" },
        "Destinations": { "classes": { "Address": "http://localhost:5190/" } }
      },
      "bookings": {
        "Metadata": { "DisplayName": "Reservas" },
        "Destinations": { "bookings": { "Address": "http://localhost:5200/" } }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
